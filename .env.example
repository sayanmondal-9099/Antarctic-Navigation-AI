# Application Environment (development | demo | production)
APP_ENV=development

# Data Mode (demo | cached | live | auto)
DATA_MODE=demo

# Enforce strict deterministic demo behavior for presentation
DEMO_MODE=true

# Feature Flags
ML_ENABLED=false
AIS_ENABLED=false
DEMO_ALLOW_UNAUTHENTICATED=true

# API URLs
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Supabase Configuration (Backend / Private - Obtained from new Supabase project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# External Scientific API Keys (Backend-only, optional with offline fallback)
COPERNICUS_USERNAME=
CDS_API_KEY=
AIS_API_KEY=
